@{
    ViewData["Title"] = "Access Denied - AutoCare";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="p-5 bg-white rounded-3 border shadow-sm">
                <div class="text-danger mb-3" style="font-size: 3.5rem;">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <h2 class="brand-font fw-bold mb-2">Access Restricted</h2>
                <p class="text-muted mb-4">
                    You do not have the required administrative role or privileges to access this page. Please sign in with an authorized account or return to your dashboard.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-autocare-outline">
                        <i class="fa-solid fa-house me-1"></i>Back to Home
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-autocare-primary">
                        <i class="fa-solid fa-arrow-right-to-bracket me-1"></i>Switch Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
