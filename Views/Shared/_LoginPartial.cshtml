@using Microsoft.AspNetCore.Identity
@using AutoCare.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var isAdmin = User.IsInRole("Admin");

    <li class="nav-item dropdown">
        <a class="nav-link nav-link-autocare dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="badge rounded-circle bg-warning text-dark p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">
                <i class="fa-solid fa-user-check"></i>
            </span>
            <span>@(currentUser?.FullName ?? User.Identity?.Name)</span>
            @if (isAdmin)
            {
                <span class="badge bg-danger ms-1" style="font-size: 0.7rem;">ADMIN</span>
            }
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown">
            @if (isAdmin)
            {
                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Dashboard"><i class="fa-solid fa-gauge-high me-2 text-primary"></i>Admin Dashboard</a></li>
                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Requests"><i class="fa-solid fa-clipboard-list me-2 text-warning"></i>Service Requests</a></li>
                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Services"><i class="fa-solid fa-screwdriver-wrench me-2 text-info"></i>Manage Services</a></li>
                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Customers"><i class="fa-solid fa-users me-2 text-success"></i>Customers</a></li>
                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Profile"><i class="fa-solid fa-user-shield me-2 text-warning"></i>Admin Profile</a></li>
            }
            else
            {
                <li><a class="dropdown-item py-2" asp-controller="Customer" asp-action="Dashboard"><i class="fa-solid fa-gauge-high me-2 text-primary"></i>Customer Dashboard</a></li>
                <li><a class="dropdown-item py-2" asp-controller="Customer" asp-action="Vehicles"><i class="fa-solid fa-car me-2 text-info"></i>My Vehicles</a></li>
                <li><a class="dropdown-item py-2" asp-controller="Customer" asp-action="BookService"><i class="fa-solid fa-calendar-plus me-2 text-success"></i>Book a Service</a></li>
                <li><a class="dropdown-item py-2" asp-controller="Customer" asp-action="MyRequests"><i class="fa-solid fa-clock-rotate-left me-2 text-warning"></i>My Service Requests</a></li>
                <li><a class="dropdown-item py-2" asp-controller="Customer" asp-action="Profile"><i class="fa-solid fa-user me-2 text-warning"></i>My Profile</a></li>
            }
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger py-2">
                        <i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Sign Out
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a class="nav-link nav-link-autocare" asp-controller="Account" asp-action="Login">
            <i class="fa-solid fa-arrow-right-to-bracket me-1"></i>Login
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-autocare-gold btn-sm px-3" asp-controller="Account" asp-action="Register">
            <i class="fa-solid fa-user-plus me-1"></i>Register
        </a>
    </li>
}
</ul>
