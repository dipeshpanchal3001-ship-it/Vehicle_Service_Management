@model AutoCare.ViewModels.CustomerDashboardViewModel
@{
    ViewData["Title"] = "Customer Dashboard - AutoCare";
}

<div class="container py-4">
    <!-- Welcome Header & Quick Action Buttons -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <div class="text-uppercase fw-bold small text-muted">Customer Service Hub</div>
            <h1 class="h3 brand-font mb-1">Welcome back, @Model.CustomerName!</h1>
            <p class="text-muted small mb-0">Manage your vehicle garage, track active service requests, and schedule bookings.</p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a asp-action="AddVehicle" class="btn btn-autocare-outline btn-sm">
                <i class="fa-solid fa-car me-1"></i>+ Add Vehicle
            </a>
            <a asp-action="BookService" class="btn btn-autocare-gold btn-sm">
                <i class="fa-solid fa-calendar-plus me-1"></i>Book a Service
            </a>
        </div>
    </div>

    <!-- Metric KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div>
                    <div class="kpi-value">@Model.TotalVehicles</div>
                    <div class="kpi-label">Registered Vehicles</div>
                </div>
                <div class="kpi-icon-wrap" style="background-color: #E0E7FF; color: #3730A3;">
                    <i class="fa-solid fa-car-side"></i>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div>
                    <div class="kpi-value">@Model.TotalBookings</div>
                    <div class="kpi-label">Total Bookings</div>
                </div>
                <div class="kpi-icon-wrap" style="background-color: #FEF3C7; color: #92400E;">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div>
                    <div class="kpi-value">@Model.PendingBookings</div>
                    <div class="kpi-label">Pending Approval</div>
                </div>
                <div class="kpi-icon-wrap" style="background-color: #FEE2E2; color: #991B1B;">
                    <i class="fa-solid fa-hourglass-half"></i>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div>
                    <div class="kpi-value">@Model.CompletedServices</div>
                    <div class="kpi-label">Completed Services</div>
                </div>
                <div class="kpi-icon-wrap" style="background-color: #DCFCE7; color: #166534;">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Vehicles & Recent Requests Rows -->
    <div class="row g-4">
        <!-- My Garage Vehicles -->
        <div class="col-lg-5">
            <div class="classic-card h-100">
                <div class="classic-card-header">
                    <h5><i class="fa-solid fa-warehouse text-warning me-2"></i>My Vehicles (@Model.Vehicles.Count)</h5>
                    <a asp-action="Vehicles" class="small text-decoration-none fw-bold text-primary">View All</a>
                </div>
                <div class="classic-card-body p-3">
                    @if (Model.Vehicles.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var v in Model.Vehicles)
                            {
                                <div class="list-group-item px-0 py-2 border-bottom">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle bg-light border p-2 text-primary" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                                <i class="@(v.VehicleType == "Bike" || v.VehicleType == "Scooter" ? "fa-solid fa-motorcycle" : "fa-solid fa-car")"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-navy" style="font-size: 0.95rem;">@v.Brand @v.Model</div>
                                                <div class="text-muted small">
                                                    <span class="badge bg-secondary me-1">@v.RegistrationNumber</span>
                                                    <span>@v.FuelType &bull; @v.ManufacturingYear</span>
                                                </div>
                                            </div>
                                        </div>
                                        <a asp-action="BookService" asp-route-vehicleId="@v.VehicleId" class="btn btn-outline-primary btn-sm py-1 px-2" title="Book Service for this vehicle">
                                            <i class="fa-solid fa-wrench"></i> Book
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fa-solid fa-car-burst fs-2 mb-2 text-black-50"></i>
                            <p class="small mb-3">You haven't added any vehicles to your garage yet.</p>
                            <a asp-action="AddVehicle" class="btn btn-autocare-primary btn-sm">Add Your First Vehicle</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Service Requests -->
        <div class="col-lg-7">
            <div class="classic-card h-100">
                <div class="classic-card-header">
                    <h5><i class="fa-solid fa-clock-rotate-left text-warning me-2"></i>Recent Service Bookings</h5>
                    <a asp-action="MyRequests" class="small text-decoration-none fw-bold text-primary">All Bookings</a>
                </div>
                <div class="classic-card-body p-0">
                    @if (Model.RecentRequests.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-autocare table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Request #</th>
                                        <th>Vehicle</th>
                                        <th>Service</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model.RecentRequests)
                                    {
                                        var badgeClass = r.Status switch
                                        {
                                            "Pending" => "status-pending",
                                            "Approved" => "status-approved",
                                            "In Progress" => "status-inprogress",
                                            "Completed" => "status-completed",
                                            "Rejected" => "status-rejected",
                                            _ => "status-cancelled"
                                        };

                                        <tr>
                                            <td>
                                                <a asp-action="RequestDetails" asp-route-id="@r.RequestId" class="fw-bold text-decoration-none text-navy">
                                                    @r.RequestNumber
                                                </a>
                                            </td>
                                            <td>
                                                <div class="fw-semibold small">@r.Vehicle?.Brand @r.Vehicle?.Model</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">@r.Vehicle?.RegistrationNumber</div>
                                            </td>
                                            <td class="small">@r.ServiceNameSnapshot</td>
                                            <td class="small text-muted">@r.PreferredDate.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <span class="badge-status @badgeClass">@r.Status</span>
                                            </td>
                                            <td class="text-end">
                                                <a asp-action="RequestDetails" asp-route-id="@r.RequestId" class="btn btn-light btn-sm border" title="View Details">
                                                    <i class="fa-solid fa-eye text-muted"></i>
                                                </a>
                                                @if (r.Status == "Completed" && r.Invoice != null)
                                                {
                                                    <a asp-action="Invoice" asp-route-id="@r.RequestId" class="btn btn-outline-success btn-sm ms-1" title="View Invoice">
                                                        <i class="fa-solid fa-receipt"></i>
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa-solid fa-clipboard-question fs-2 mb-2 text-black-50"></i>
                            <p class="small mb-2">No service bookings made yet.</p>
                            <a asp-action="BookService" class="btn btn-autocare-gold btn-sm">Book Your First Service</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
