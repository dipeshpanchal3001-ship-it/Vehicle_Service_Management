@model AutoCare.Models.ServiceRequest
@{
    ViewData["Title"] = $"Request #{Model.RequestNumber} - AutoCare";

    var badgeClass = Model.Status switch
    {
        "Pending" => "status-pending",
        "Approved" => "status-approved",
        "In Progress" => "status-inprogress",
        "Completed" => "status-completed",
        "Rejected" => "status-rejected",
        _ => "status-cancelled"
    };
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a asp-action="MyRequests" class="text-decoration-none text-muted small">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to My Service Requests
        </a>

        @if (Model.Status == "Completed" && Model.Invoice != null)
        {
            <a asp-action="Invoice" asp-route-id="@Model.RequestId" class="btn btn-outline-success btn-sm">
                <i class="fa-solid fa-receipt me-1"></i>View & Print Invoice
            </a>
        }
    </div>

    <div class="row g-4">
        <!-- Main Details Column -->
        <div class="col-lg-8">
            <div class="classic-card mb-4">
                <div class="classic-card-header bg-light">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary p-2 rounded-circle">
                            <i class="fa-solid fa-wrench text-white"></i>
                        </span>
                        <div>
                            <h5 class="mb-0">Booking #@Model.RequestNumber</h5>
                            <span class="text-muted small">Submitted on @Model.CreatedAt.ToString("f")</span>
                        </div>
                    </div>
                    <span class="badge-status @badgeClass fs-6">@Model.Status</span>
                </div>

                <div class="classic-card-body p-4">
                    <!-- Service & Estimate Box -->
                    <div class="row g-3 p-3 bg-light rounded border mb-4">
                        <div class="col-md-7">
                            <span class="text-muted small text-uppercase fw-bold">Service Package</span>
                            <h5 class="text-primary brand-font mb-1">@Model.ServiceNameSnapshot</h5>
                            <div class="small text-muted">Base Service Charge (Pre-tax snapshot)</div>
                        </div>
                        <div class="col-md-5 text-md-end">
                            <span class="text-muted small text-uppercase fw-bold">Base Estimated Cost</span>
                            <div class="fs-4 fw-bold text-dark">₹@Model.ServicePriceSnapshot.ToString("N0")</div>
                        </div>
                    </div>

                    <!-- Booking Schedule -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 border rounded">
                                <div class="text-muted small fw-bold text-uppercase"><i class="fa-solid fa-calendar me-1 text-warning"></i> Preferred Date</div>
                                <div class="fs-6 fw-bold mt-1 text-dark">@Model.PreferredDate.ToString("dddd, dd MMMM yyyy")</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border rounded">
                                <div class="text-muted small fw-bold text-uppercase"><i class="fa-solid fa-clock me-1 text-warning"></i> Reserved Time Slot</div>
                                <div class="fs-6 fw-bold mt-1 text-dark">@Model.PreferredTime</div>
                            </div>
                        </div>
                    </div>

                    <!-- Problem Description & Customer Notes -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-navy mb-2"><i class="fa-solid fa-clipboard-question text-warning me-1"></i> Problem Description / Symptoms</h6>
                        <div class="p-3 bg-white border rounded text-dark">
                            @Model.ProblemDescription
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.AdditionalNotes))
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-navy mb-2"><i class="fa-solid fa-note-sticky text-warning me-1"></i> Customer Special Instructions</h6>
                            <div class="p-3 bg-white border rounded text-muted small">
                                @Model.AdditionalNotes
                            </div>
                        </div>
                    }

                    <!-- Workshop Admin Remarks -->
                    <div class="p-3 rounded border @(string.IsNullOrEmpty(Model.AdminRemarks) ? "bg-light" : "bg-warning bg-opacity-10 border-warning")">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="fa-solid fa-user-gear text-primary"></i>
                            <strong class="text-navy">Service Center Advisory & Bay Remarks</strong>
                        </div>
                        <p class="mb-0 small @(string.IsNullOrEmpty(Model.AdminRemarks) ? "text-muted" : "text-dark fw-semibold")">
                            @(string.IsNullOrEmpty(Model.AdminRemarks) ? "Your booking is in queue. Remarks and assigned bay technician will be posted here." : Model.AdminRemarks)
                        </p>
                    </div>

                    @if (Model.Status == "Pending")
                    {
                        <div class="mt-4 pt-3 border-top text-end">
                            <form asp-action="CancelRequest" asp-route-id="@Model.RequestId" method="post" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="fa-solid fa-xmark me-1"></i>Cancel Booking Request
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar Details -->
        <div class="col-lg-4">
            <!-- Vehicle Card -->
            <div class="classic-card mb-4">
                <div class="classic-card-header bg-light">
                    <h6 class="mb-0 fw-bold"><i class="fa-solid fa-car text-warning me-2"></i>Assigned Vehicle</h6>
                </div>
                <div class="classic-card-body p-3">
                    @if (Model.Vehicle != null)
                    {
                        <div class="fw-bold fs-6 text-navy mb-1">@Model.Vehicle.Brand @Model.Vehicle.Model</div>
                        <div class="badge bg-secondary mb-3">@Model.Vehicle.RegistrationNumber</div>
                        <div class="small text-muted">
                            <div class="mb-1"><span class="fw-semibold text-dark">Type:</span> @Model.Vehicle.VehicleType</div>
                            <div class="mb-1"><span class="fw-semibold text-dark">Fuel:</span> @Model.Vehicle.FuelType</div>
                            <div><span class="fw-semibold text-dark">Year:</span> @Model.Vehicle.ManufacturingYear</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Invoice Card if available -->
            @if (Model.Invoice != null)
            {
                <div class="classic-card">
                    <div class="classic-card-header bg-light">
                        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-receipt text-success me-2"></i>Invoice Summary</h6>
                        <span class="badge bg-success">PAID</span>
                    </div>
                    <div class="classic-card-body p-3">
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Invoice No:</span>
                            <span class="fw-bold">@Model.Invoice.InvoiceNumber</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Service Charge:</span>
                            <span>₹@Model.Invoice.ServiceCharge.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Additional / Spares:</span>
                            <span>₹@Model.Invoice.AdditionalCharges.ToString("N0")</span>
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between fw-bold mb-3">
                            <span>Total Paid:</span>
                            <span class="text-primary fs-5">₹@Model.Invoice.TotalAmount.ToString("N0")</span>
                        </div>
                        <a asp-action="Invoice" asp-route-id="@Model.RequestId" class="btn btn-autocare-primary w-100 btn-sm">
                            <i class="fa-solid fa-print me-1"></i>Print Invoice
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
