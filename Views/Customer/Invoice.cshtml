@model AutoCare.Models.ServiceRequest
@{
    ViewData["Title"] = $"Invoice {Model.Invoice?.InvoiceNumber} - AutoCare";
    var invoice = Model.Invoice;
}

<div class="container py-4">
    <!-- Non-printable top action bar -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <a asp-action="MyRequests" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to My Requests
        </a>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-autocare-primary btn-sm">
                <i class="fa-solid fa-print me-1"></i>Print / Save as PDF
            </button>
        </div>
    </div>

    @if (invoice != null)
    {
        <!-- Printable Invoice Container -->
        <div class="invoice-box">
            <!-- Header with Logo and Title -->
            <div class="invoice-header d-flex justify-content-between align-items-start">
                <div class="d-flex align-items-center gap-3">
                    <div class="brand-emblem" style="width: 48px; height: 48px; font-size: 1.4rem;">
                        <i class="fa-solid fa-car-side"></i>
                    </div>
                    <div>
                        <h2 class="brand-title text-navy mb-0" style="color: var(--primary-navy) !important;">AutoCare</h2>
                        <div class="brand-tagline">Vehicle Service Management Center</div>
                    </div>
                </div>
                <div class="text-end">
                    <h3 class="brand-font text-uppercase text-navy mb-1" style="color: var(--primary-navy);">Tax Invoice</h3>
                    <div class="badge bg-success px-3 py-1">PAID IN FULL</div>
                </div>
            </div>

            <!-- Invoice Metadata & Customer Info -->
            <div class="row g-4 mb-4">
                <div class="col-6">
                    <h6 class="text-uppercase fw-bold text-muted small mb-2">Billed To (Customer):</h6>
                    <div class="fw-bold fs-6 text-dark">@(Model.User?.FullName ?? "Valued Customer")</div>
                    <div class="text-muted small">Email: @(Model.User?.Email ?? "N/A")</div>
                    <div class="text-muted small">Phone: @(Model.User?.PhoneNumber ?? "N/A")</div>
                </div>

                <div class="col-6 text-end">
                    <h6 class="text-uppercase fw-bold text-muted small mb-2">Invoice Summary:</h6>
                    <div class="small"><strong class="text-dark">Invoice Number:</strong> @invoice.InvoiceNumber</div>
                    <div class="small"><strong class="text-dark">Booking Reference:</strong> @Model.RequestNumber</div>
                    <div class="small"><strong class="text-dark">Invoice Date:</strong> @invoice.InvoiceDate.ToString("dd MMMM yyyy")</div>
                    <div class="small"><strong class="text-dark">Payment Status:</strong> @invoice.PaymentStatus</div>
                </div>
            </div>

            <!-- Vehicle Details Bar -->
            <div class="p-3 bg-light rounded border mb-4">
                <div class="row g-2 align-items-center">
                    <div class="col-md-3">
                        <span class="text-muted small text-uppercase fw-bold">Vehicle:</span>
                        <div class="fw-bold text-navy">@Model.Vehicle?.Brand @Model.Vehicle?.Model</div>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small text-uppercase fw-bold">Reg. Number:</span>
                        <div><span class="badge bg-dark">@Model.Vehicle?.RegistrationNumber</span></div>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small text-uppercase fw-bold">Type & Fuel:</span>
                        <div class="small text-dark">@Model.Vehicle?.VehicleType (@Model.Vehicle?.FuelType)</div>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small text-uppercase fw-bold">Service Bay Date:</span>
                        <div class="small text-dark">@Model.PreferredDate.ToString("dd MMM yyyy")</div>
                    </div>
                </div>
            </div>

            <!-- Line Items Table -->
            <table class="table table-bordered mb-4">
                <thead class="table-light">
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th style="width: 65%;">Description of Service / Replacement Parts</th>
                        <th class="text-end" style="width: 30%;">Amount (INR)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>
                            <strong>@Model.ServiceNameSnapshot</strong>
                            <div class="text-muted small">Standard authorized periodic service package charge</div>
                        </td>
                        <td class="text-end fw-semibold">₹@invoice.ServiceCharge.ToString("N2")</td>
                    </tr>
                    @if (invoice.AdditionalCharges > 0)
                    {
                        <tr>
                            <td>2</td>
                            <td>
                                <strong>Additional Parts / Extra Diagnostic Work</strong>
                                <div class="text-muted small">Replaced components & consumables authorized during service</div>
                            </td>
                            <td class="text-end fw-semibold">₹@invoice.AdditionalCharges.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="2" class="text-end">Subtotal:</th>
                        <td class="text-end fw-semibold">₹@invoice.TotalAmount.ToString("N2")</td>
                    </tr>
                    <tr class="table-light">
                        <th colspan="2" class="text-end fs-5 brand-font text-navy">Grand Total (Net Paid):</th>
                        <td class="text-end fs-5 fw-bold text-navy">₹@invoice.TotalAmount.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>

            <!-- Technician Remarks & Warranty Terms -->
            <div class="border rounded p-3 bg-light mb-4">
                <div class="fw-bold small text-navy mb-1"><i class="fa-solid fa-circle-check text-success me-1"></i> Workshop Notes & Warranty Certification:</div>
                <p class="small text-muted mb-0">
                    @(string.IsNullOrEmpty(invoice.Notes) ? "Service completed with OEM diagnostic clearance. 60-day or 1,500 km warranty covers labor and fitted parts." : invoice.Notes)
                </p>
            </div>

            <!-- Footer & Signatures -->
            <div class="row pt-4 border-top text-center text-md-start">
                <div class="col-md-7">
                    <p class="small text-muted mb-1">
                        <strong>AutoCare Workshop Hub</strong> &bull; Central Avenue, New Delhi, India<br />
                        GSTIN: 07AAACA0000A1Z5 &bull; CIN: U50400DL2026PTC001234<br />
                        Helpline: +91 (011) 4567-8900 &bull; support@autocare.com
                    </p>
                </div>
                <div class="col-md-5 text-md-end mt-3 mt-md-0">
                    <div class="border-top border-dark d-inline-block pt-1 px-4 text-center">
                        <div class="fw-bold small">Authorized Signatory</div>
                        <div class="text-muted small">AutoCare Service Manager</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
