@model IEnumerable<AutoCare.Models.ServiceRequest>
@{
    ViewData["Title"] = "My Service Requests - AutoCare";
    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    var fromDate = ViewBag.FromDate as string ?? "";
    var toDate = ViewBag.ToDate as string ?? "";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="text-uppercase fw-bold small text-muted">Service Tracking</div>
            <h1 class="h3 brand-font mb-1">My Service Requests</h1>
            <p class="text-muted small mb-0">Track real-time workshop status, bay confirmations, technician notes, and invoices.</p>
        </div>
        <div class="mt-2 mt-md-0">
            <a asp-action="BookService" class="btn btn-autocare-gold">
                <i class="fa-solid fa-plus me-1"></i>New Booking
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="classic-card mb-4">
        <div class="classic-card-body p-3">
            <form method="get" asp-action="MyRequests" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted mb-1">Status Filter</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="All" selected="@(selectedStatus == "All")">All Statuses</option>
                        <option value="Pending" selected="@(selectedStatus == "Pending")">Pending</option>
                        <option value="Approved" selected="@(selectedStatus == "Approved")">Approved</option>
                        <option value="In Progress" selected="@(selectedStatus == "In Progress")">In Progress</option>
                        <option value="Completed" selected="@(selectedStatus == "Completed")">Completed</option>
                        <option value="Rejected" selected="@(selectedStatus == "Rejected")">Rejected</option>
                        <option value="Cancelled" selected="@(selectedStatus == "Cancelled")">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">From Preferred Date</label>
                    <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">To Preferred Date</label>
                    <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-autocare-primary btn-sm flex-grow-1">
                        <i class="fa-solid fa-filter me-1"></i>Filter
                    </button>
                    <a asp-action="MyRequests" class="btn btn-outline-secondary btn-sm" title="Reset Filters">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Requests Table -->
    <div class="classic-card">
        <div class="classic-card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-autocare table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Request #</th>
                                <th>Vehicle</th>
                                <th>Service</th>
                                <th>Service Date & Slot</th>
                                <th>Estimated Cost</th>
                                <th>Status</th>
                                <th>Admin Remarks</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var badgeClass = item.Status switch
                                {
                                    "Pending" => "status-pending",
                                    "Approved" => "status-approved",
                                    "In Progress" => "status-inprogress",
                                    "Completed" => "status-completed",
                                    "Rejected" => "status-rejected",
                                    _ => "status-cancelled"
                                };

                                <tr>
                                    <td>
                                        <a asp-action="RequestDetails" asp-route-id="@item.RequestId" class="fw-bold text-decoration-none text-navy">
                                            @item.RequestNumber
                                        </a>
                                        <div class="text-muted" style="font-size: 0.72rem;">Booked: @item.CreatedAt.ToString("dd MMM yyyy")</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.Vehicle?.Brand @item.Vehicle?.Model</div>
                                        <span class="badge bg-secondary" style="font-size: 0.7rem;">@item.Vehicle?.RegistrationNumber</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.ServiceNameSnapshot</div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold">@item.PreferredDate.ToString("dd MMM yyyy")</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">@item.PreferredTime</div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">₹@item.ServicePriceSnapshot.ToString("N0")</span>
                                    </td>
                                    <td>
                                        <span class="badge-status @badgeClass">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="small text-muted" style="max-width: 200px;">
                                        @(string.IsNullOrEmpty(item.AdminRemarks) ? "—" : item.AdminRemarks)
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="RequestDetails" asp-route-id="@item.RequestId" class="btn btn-light btn-sm border" title="View Details">
                                                <i class="fa-solid fa-eye text-muted"></i>
                                            </a>

                                            @if (item.Status == "Completed" && item.Invoice != null)
                                            {
                                                <a asp-action="Invoice" asp-route-id="@item.RequestId" class="btn btn-outline-success btn-sm" title="View Invoice">
                                                    <i class="fa-solid fa-receipt"></i>
                                                </a>
                                            }

                                            @if (item.Status == "Pending")
                                            {
                                                <form asp-action="CancelRequest" asp-route-id="@item.RequestId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel request #@item.RequestNumber?');">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Cancel Booking">
                                                        <i class="fa-solid fa-xmark"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-calendar-xmark fs-2 mb-2 text-black-50"></i>
                    <p class="mb-2">No service requests found matching your filter criteria.</p>
                    <a asp-action="BookService" class="btn btn-autocare-gold btn-sm">Book a Service Now</a>
                </div>
            }
        </div>
    </div>
</div>
