@model AutoCare.ViewModels.VehicleServiceViewModel
@{
    ViewData["Title"] = "Edit Service - Admin AutoCare";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <a asp-action="Services" class="text-decoration-none text-muted small">
                    <i class="fa-solid fa-arrow-left me-1"></i>Back to Service Catalog
                </a>
            </div>

            <div class="classic-card">
                <div class="classic-card-header">
                    <h5><i class="fa-solid fa-pen-to-square text-warning me-2"></i>Edit Service Package</h5>
                    <span class="badge bg-secondary">ID: #@Model.ServiceId</span>
                </div>

                <div class="classic-card-body p-4">
                    <form asp-action="EditService" asp-route-id="@Model.ServiceId" method="post" class="form-autocare">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>
                        <input type="hidden" asp-for="ServiceId" />

                        <div class="mb-3">
                            <label asp-for="ServiceName" class="form-label"></label>
                            <input asp-for="ServiceName" class="form-control" />
                            <span asp-validation-for="ServiceName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted">₹</span>
                                    <input asp-for="Price" type="number" step="1" class="form-control" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EstimatedDuration" class="form-label"></label>
                                <input asp-for="EstimatedDuration" class="form-control" />
                                <span asp-validation-for="EstimatedDuration" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-8">
                                <label asp-for="IconClass" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted" id="iconPreview"><i class="@Model.IconClass"></i></span>
                                    <input asp-for="IconClass" class="form-control" id="iconClassInput" />
                                </div>
                                <span asp-validation-for="IconClass" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 d-flex align-items-center pt-3">
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Services" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-autocare-primary px-4">
                                <i class="fa-solid fa-check me-1"></i>Update Service
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#iconClassInput').on('input', function () {
            var icon = $(this).val();
            $('#iconPreview i').attr('class', icon || 'fa-solid fa-wrench');
        });
    </script>
}
