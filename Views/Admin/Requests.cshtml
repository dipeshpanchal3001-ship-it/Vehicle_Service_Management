@model IEnumerable<AutoCare.Models.ServiceRequest>
@{
    ViewData["Title"] = "Manage Service Requests - Admin AutoCare";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    var fromDate = ViewBag.FromDate as string ?? "";
    var toDate = ViewBag.ToDate as string ?? "";
}

<div class="container-fluid px-lg-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="text-uppercase fw-bold small text-muted">Operations Control</div>
            <h1 class="h3 brand-font mb-1">Customer Service Requests</h1>
            <p class="text-muted small mb-0">Review booking slots, allocate bay technicians, record diagnostic remarks, and issue invoices.</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex gap-2">
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i>Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="classic-card mb-4">
        <div class="classic-card-body p-3">
            <form method="get" asp-action="Requests" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Search Keyword</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="search" value="@searchTerm" class="form-control" placeholder="Req #, Customer, Reg No, Brand..." />
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Status Filter</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="All" selected="@(selectedStatus == "All")">All Statuses</option>
                        <option value="Pending" selected="@(selectedStatus == "Pending")">Pending</option>
                        <option value="Approved" selected="@(selectedStatus == "Approved")">Approved</option>
                        <option value="In Progress" selected="@(selectedStatus == "In Progress")">In Progress</option>
                        <option value="Completed" selected="@(selectedStatus == "Completed")">Completed</option>
                        <option value="Rejected" selected="@(selectedStatus == "Rejected")">Rejected</option>
                        <option value="Cancelled" selected="@(selectedStatus == "Cancelled")">Cancelled</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">From Date</label>
                    <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">To Date</label>
                    <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-autocare-primary btn-sm flex-grow-1">
                        <i class="fa-solid fa-filter me-1"></i>Search
                    </button>
                    <a asp-action="Requests" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="classic-card">
        <div class="classic-card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-autocare table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Request #</th>
                                <th>Customer Information</th>
                                <th>Vehicle Details</th>
                                <th>Requested Service</th>
                                <th>Preferred Schedule</th>
                                <th>Estimated</th>
                                <th>Status</th>
                                <th class="text-end" style="min-width: 170px;">Operations</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                var badgeClass = r.Status switch
                                {
                                    "Pending" => "status-pending",
                                    "Approved" => "status-approved",
                                    "In Progress" => "status-inprogress",
                                    "Completed" => "status-completed",
                                    "Rejected" => "status-rejected",
                                    _ => "status-cancelled"
                                };

                                <tr>
                                    <td>
                                        <a asp-action="RequestDetails" asp-route-id="@r.RequestId" class="fw-bold text-decoration-none text-navy">
                                            @r.RequestNumber
                                        </a>
                                        <div class="text-muted" style="font-size: 0.72rem;">@r.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@(r.User?.FullName ?? "N/A")</div>
                                        <div class="text-muted small">
                                            <i class="fa-solid fa-phone me-1"></i>@(r.User?.PhoneNumber ?? "—")
                                        </div>
                                        <div class="text-muted" style="font-size: 0.72rem;">@(r.User?.Email)</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@r.Vehicle?.Brand @r.Vehicle?.Model</div>
                                        <span class="badge bg-secondary" style="font-size: 0.7rem;">@r.Vehicle?.RegistrationNumber</span>
                                        <div class="text-muted" style="font-size: 0.72rem;">@r.Vehicle?.FuelType &bull; @r.Vehicle?.ManufacturingYear</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@r.ServiceNameSnapshot</div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold">@r.PreferredDate.ToString("dd MMM yyyy")</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">@r.PreferredTime</div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">₹@r.ServicePriceSnapshot.ToString("N0")</span>
                                    </td>
                                    <td>
                                        <span class="badge-status @badgeClass">@r.Status</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="RequestDetails" asp-route-id="@r.RequestId" class="btn btn-autocare-primary btn-sm py-1 px-2" title="Manage Status & Details">
                                                <i class="fa-solid fa-sliders"></i>
                                            </a>

                                            @if (r.Status == "Pending")
                                            {
                                                <form asp-action="QuickApprove" asp-route-id="@r.RequestId" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-success btn-sm py-1 px-2" title="Approve Request">
                                                        <i class="fa-solid fa-check"></i>
                                                    </button>
                                                </form>

                                                <button type="button" class="btn btn-danger btn-sm py-1 px-2" data-bs-toggle="modal" data-bs-target="#rejectModal-@r.RequestId" title="Reject Request">
                                                    <i class="fa-solid fa-xmark"></i>
                                                </button>
                                            }

                                            @if (r.Status == "Completed" && r.Invoice != null)
                                            {
                                                <a asp-action="Invoice" asp-route-id="@r.RequestId" class="btn btn-outline-success btn-sm py-1 px-2" title="View Printable Invoice">
                                                    <i class="fa-solid fa-receipt"></i>
                                                </a>
                                            }
                                        </div>

                                        <!-- Quick Reject Modal -->
                                        @if (r.Status == "Pending")
                                        {
                                            <div class="modal fade" id="rejectModal-@r.RequestId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content text-start">
                                                        <form asp-action="QuickReject" asp-route-id="@r.RequestId" method="post">
                                                            <div class="modal-header bg-danger text-white">
                                                                <h5 class="modal-title">
                                                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Reject Request #@r.RequestNumber
                                                                </h5>
                                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p class="small text-muted mb-3">Please specify a clear reason for rejecting this booking so the customer is properly notified.</p>
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-bold small">Reason for Rejection *</label>
                                                                    <textarea name="rejectionReason" class="form-control" rows="3" required placeholder="e.g. Workshop bays fully booked on requested date, or parts unavailable."></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-danger btn-sm">Confirm Rejection</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-magnifying-glass fs-2 mb-2 text-black-50"></i>
                    <p class="mb-0">No service requests found matching your filter criteria.</p>
                </div>
            }
        </div>
    </div>
</div>
