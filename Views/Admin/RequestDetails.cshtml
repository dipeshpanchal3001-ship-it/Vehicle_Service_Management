@model AutoCare.ViewModels.RequestStatusUpdateViewModel
@{
    ViewData["Title"] = $"Manage Request #{Model.RequestNumber} - Admin AutoCare";
    var request = ViewBag.ServiceRequest as AutoCare.Models.ServiceRequest;

    var badgeClass = Model.CurrentStatus switch
    {
        "Pending" => "status-pending",
        "Approved" => "status-approved",
        "In Progress" => "status-inprogress",
        "Completed" => "status-completed",
        "Rejected" => "status-rejected",
        _ => "status-cancelled"
    };
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a asp-action="Requests" class="text-decoration-none text-muted small">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to All Requests
        </a>

        @if (Model.CurrentStatus == "Completed" && request?.Invoice != null)
        {
            <a asp-action="Invoice" asp-route-id="@Model.RequestId" class="btn btn-outline-success btn-sm">
                <i class="fa-solid fa-receipt me-1"></i>View / Print Invoice
            </a>
        }
    </div>

    <div class="row g-4">
        <!-- Left: Status & Update Form -->
        <div class="col-lg-7">
            <div class="classic-card mb-4">
                <div class="classic-card-header bg-light">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary p-2 rounded-circle">
                            <i class="fa-solid fa-sliders text-white"></i>
                        </span>
                        <div>
                            <h5 class="mb-0">Manage Service Request #@Model.RequestNumber</h5>
                            <span class="text-muted small">Booking ID: @Model.RequestId</span>
                        </div>
                    </div>
                    <span class="badge-status @badgeClass fs-6">@Model.CurrentStatus</span>
                </div>

                <div class="classic-card-body p-4">
                    <form asp-action="UpdateStatus" method="post" class="form-autocare" id="statusForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>
                        <input type="hidden" asp-for="RequestId" />
                        <input type="hidden" asp-for="RequestNumber" />
                        <input type="hidden" asp-for="ServicePrice" id="baseServicePrice" />

                        <!-- Status Transition Selector -->
                        <div class="mb-3">
                            <label asp-for="NewStatus" class="form-label fw-bold"></label>
                            <select asp-for="NewStatus" class="form-select" id="newStatusSelect">
                                <option value="Pending">Pending (Awaiting Review)</option>
                                <option value="Approved">Approved (Bay Scheduled)</option>
                                <option value="In Progress">In Progress (Work Underway in Bay)</option>
                                <option value="Completed">Completed (Ready for Delivery & Invoice)</option>
                                <option value="Rejected">Rejected (Declined with Reason)</option>
                                <option value="Cancelled">Cancelled (Terminated)</option>
                            </select>
                            <span asp-validation-for="NewStatus" class="text-danger small"></span>
                        </div>

                        <!-- Admin Remarks & Advisory -->
                        <div class="mb-3">
                            <label asp-for="AdminRemarks" class="form-label fw-bold"></label>
                            <textarea asp-for="AdminRemarks" class="form-control" rows="3" placeholder="Enter bay allocation, diagnostic findings, replaced components, or reason for rejection..."></textarea>
                            <span asp-validation-for="AdminRemarks" class="text-danger small"></span>
                            <div class="form-text small">Visible to the customer on their tracking portal. Mandatory if rejecting.</div>
                        </div>

                        <!-- Completion & Invoice Generation Fields -->
                        <div class="p-3 mb-4 rounded border bg-light" id="completionBox" style="display: @(Model.NewStatus == "Completed" ? "block" : "none");">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="fa-solid fa-file-invoice-dollar text-success fs-5"></i>
                                <strong class="text-navy">Auto-Invoice Generation Details</strong>
                            </div>

                            <div class="row g-3 mb-2">
                                <div class="col-md-6">
                                    <label class="form-label small text-muted">Base Service Charge:</label>
                                    <input type="text" class="form-control form-control-sm bg-white" readonly value="₹@Model.ServicePrice.ToString("N0")" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="AdditionalCharges" class="form-label small text-muted"></label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-white">₹</span>
                                        <input asp-for="AdditionalCharges" class="form-control" id="additionalChargesInput" type="number" step="0.01" min="0" />
                                    </div>
                                    <span asp-validation-for="AdditionalCharges" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center p-2 rounded bg-white border mb-3">
                                <span class="small fw-bold text-muted">CALCULATED TOTAL:</span>
                                <span class="fs-5 fw-bold text-primary" id="calculatedTotal">₹@Model.ServicePrice.ToString("N0")</span>
                            </div>

                            <div>
                                <label asp-for="InvoiceNotes" class="form-label small text-muted"></label>
                                <input asp-for="InvoiceNotes" class="form-control form-control-sm" placeholder="e.g. 60-day service warranty applied. Consumables replaced." />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a asp-action="Requests" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-autocare-primary px-4">
                                <i class="fa-solid fa-floppy-disk me-1"></i>Save Status Update
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right: Full Details Summary -->
        <div class="col-lg-5">
            <!-- Customer Information Card -->
            <div class="classic-card mb-3">
                <div class="classic-card-header bg-light">
                    <h6 class="mb-0 fw-bold"><i class="fa-solid fa-user text-warning me-2"></i>Customer Profile</h6>
                </div>
                <div class="classic-card-body p-3">
                    <div class="fw-bold fs-6 text-navy">@(request?.User?.FullName ?? "N/A")</div>
                    <div class="small text-muted mb-1"><i class="fa-solid fa-envelope me-1"></i>@(request?.User?.Email ?? "N/A")</div>
                    <div class="small text-muted"><i class="fa-solid fa-phone me-1"></i>@(request?.User?.PhoneNumber ?? "N/A")</div>
                </div>
            </div>

            <!-- Vehicle Information Card -->
            <div class="classic-card mb-3">
                <div class="classic-card-header bg-light">
                    <h6 class="mb-0 fw-bold"><i class="fa-solid fa-car text-warning me-2"></i>Vehicle Specifications</h6>
                </div>
                <div class="classic-card-body p-3">
                    @if (request?.Vehicle != null)
                    {
                        <div class="fw-bold fs-6 text-navy mb-1">@request.Vehicle.Brand @request.Vehicle.Model</div>
                        <div class="badge bg-dark mb-2">@request.Vehicle.RegistrationNumber</div>
                        <div class="row g-2 small text-muted">
                            <div class="col-6">Type: <span class="fw-semibold text-dark">@request.Vehicle.VehicleType</span></div>
                            <div class="col-6">Fuel: <span class="fw-semibold text-dark">@request.Vehicle.FuelType</span></div>
                            <div class="col-6">Year: <span class="fw-semibold text-dark">@request.Vehicle.ManufacturingYear</span></div>
                        </div>
                    }
                </div>
            </div>

            <!-- Problem Description Card -->
            <div class="classic-card">
                <div class="classic-card-header bg-light">
                    <h6 class="mb-0 fw-bold"><i class="fa-solid fa-circle-question text-warning me-2"></i>Customer Stated Symptoms</h6>
                </div>
                <div class="classic-card-body p-3">
                    <div class="small text-dark mb-2">
                        @request?.ProblemDescription
                    </div>
                    @if (!string.IsNullOrEmpty(request?.AdditionalNotes))
                    {
                        <hr class="my-2" />
                        <div class="small text-muted">
                            <span class="fw-bold text-dark">Additional Notes:</span> @request.AdditionalNotes
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            var basePrice = parseFloat($('#baseServicePrice').val()) || 0;

            function updateCompletionBox() {
                var status = $('#newStatusSelect').val();
                if (status === 'Completed') {
                    $('#completionBox').slideDown(200);
                    recalcTotal();
                } else {
                    $('#completionBox').slideUp(200);
                }
            }

            function recalcTotal() {
                var extra = parseFloat($('#additionalChargesInput').val()) || 0;
                var total = basePrice + extra;
                $('#calculatedTotal').text('₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2 }));
            }

            $('#newStatusSelect').on('change', updateCompletionBox);
            $('#additionalChargesInput').on('input', recalcTotal);
            updateCompletionBox();
        });
    </script>
}
