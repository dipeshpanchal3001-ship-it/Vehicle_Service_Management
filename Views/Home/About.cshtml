@{
    ViewData["Title"] = "About Us - AutoCare Vehicle Services";
}

<div class="bg-light py-5 border-bottom">
    <div class="container text-center">
        <div class="text-uppercase fw-bold small text-muted mb-1" style="letter-spacing: 2px;">Automotive Excellence</div>
        <h1 class="display-6 brand-font fw-bold">About AutoCare Workshop</h1>
        <p class="text-muted mx-auto" style="max-width: 650px;">
            Founded with a passion for classic mechanical precision and modern vehicle engineering.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5 align-items-center mb-5">
        <div class="col-lg-6">
            <h2 class="brand-font fw-bold mb-3">Craftsmanship Meets Diagnostic Technology</h2>
            <p class="text-muted">
                At <strong>AutoCare</strong>, we believe every automobile represents a remarkable synergy of mechanics and passion. Since our inception, we have served thousands of discerning vehicle owners who seek genuine transparency, certified expertise, and meticulous attention to detail.
            </p>
            <p class="text-muted">
                Our workshop spans over 15,000 square feet equipped with state-of-the-art hydraulic scissor lifts, computerized 3D laser wheel alignment systems, digital smoke opacity meters, and OEM-level electronic ECU scan tools.
            </p>
            <div class="row g-3 mt-2">
                <div class="col-6">
                    <div class="border rounded p-3 bg-white">
                        <div class="text-primary fw-bold fs-4">100%</div>
                        <div class="small text-muted">Genuine OEM Parts</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="border rounded p-3 bg-white">
                        <div class="text-primary fw-bold fs-4">25+</div>
                        <div class="small text-muted">Dedicated Service Bays</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="p-4 bg-white rounded-3 border shadow-sm">
                <h4 class="brand-font fw-bold mb-3"><i class="fa-solid fa-list-check text-warning me-2"></i>Our Service Standard</h4>
                <ul class="list-unstyled mb-0">
                    <li class="d-flex gap-3 mb-3">
                        <i class="fa-solid fa-circle-check text-success fs-5 mt-1"></i>
                        <div>
                            <strong>Standardized Multipoint Checklist</strong>
                            <div class="text-muted small">Every vehicle undergoes an exhaustive inspection covering braking, suspension, electricals, and fluid integrity.</div>
                        </div>
                    </li>
                    <li class="d-flex gap-3 mb-3">
                        <i class="fa-solid fa-circle-check text-success fs-5 mt-1"></i>
                        <div>
                            <strong>Digital Service Records</strong>
                            <div class="text-muted small">Access your complete vehicle service history, parts replaced, and invoices online anytime through your customer portal.</div>
                        </div>
                    </li>
                    <li class="d-flex gap-3 mb-3">
                        <i class="fa-solid fa-circle-check text-success fs-5 mt-1"></i>
                        <div>
                            <strong>Transparent Estimates</strong>
                            <div class="text-muted small">No hidden fees, no unauthorized repairs. We provide exact estimates before starting work.</div>
                        </div>
                    </li>
                    <li class="d-flex gap-3">
                        <i class="fa-solid fa-circle-check text-success fs-5 mt-1"></i>
                        <div>
                            <strong>Guaranteed Workmanship</strong>
                            <div class="text-muted small">60 days or 1,500 km warranty on every service performed in our facility.</div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
