@model IEnumerable<AutoCare.Models.VehicleService>
@{
    ViewData["Title"] = "Home - Classic Automotive Service Management";
}

<!-- Hero Section -->
<section class="hero-section text-center text-md-start">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="hero-subtitle">
                    <i class="fa-solid fa-shield-halved me-1"></i> Authorized Automotive Center
                </div>
                <h1 class="hero-title">
                    Reliable Vehicle Care, Every Mile.
                </h1>
                <p class="hero-lead">
                    Experience premier multi-brand automobile servicing engineered for durability, safety, and peak performance. From precision computerized diagnostics to routine periodic maintenance, we treat every vehicle like a masterpiece.
                </p>
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-md-start">
                    <a asp-controller="Customer" asp-action="BookService" class="btn btn-autocare-gold btn-lg px-4 shadow-sm">
                        <i class="fa-solid fa-calendar-check me-2"></i>Book a Service
                    </a>
                    <a href="#services-catalog" class="btn btn-autocare-outline-gold btn-lg px-4">
                        <i class="fa-solid fa-wrench me-2"></i>Explore Services
                    </a>
                </div>

                <div class="mt-4 pt-3 border-top border-white-50 d-flex flex-wrap gap-4 text-white-50 small justify-content-center justify-content-md-start">
                    <div><i class="fa-solid fa-circle-check text-warning me-1"></i> 100% Genuine OEM Spares</div>
                    <div><i class="fa-solid fa-circle-check text-warning me-1"></i> Certified Master Mechanics</div>
                    <div><i class="fa-solid fa-circle-check text-warning me-1"></i> Upfront Transparent Pricing</div>
                </div>
            </div>

            <div class="col-lg-5 text-center">
                <div class="p-4 rounded-3 text-white border border-white-50 shadow-lg" style="background: rgba(13, 28, 45, 0.7); backdrop-filter: blur(8px);">
                    <div class="brand-emblem mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.6rem;">
                        <i class="fa-solid fa-gauge-high"></i>
                    </div>
                    <h4 class="text-white mb-2">Express Service Bay</h4>
                    <p class="text-white-50 small mb-4">
                        Get periodic servicing completed in under 90 minutes with our reserved express diagnostic bays.
                    </p>
                    <div class="bg-white p-3 rounded text-dark text-start mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-muted fw-bold">WORKSHOP STATUS</span>
                            <span class="badge bg-success">OPERATIONAL</span>
                        </div>
                        <div class="fw-bold text-navy" style="font-size: 0.95rem;">
                            <i class="fa-solid fa-clock text-warning me-1"></i> Today's Hours: 8:00 AM – 7:30 PM
                        </div>
                    </div>
                    <a asp-controller="Customer" asp-action="BookService" class="btn btn-autocare-gold w-100 fw-bold">
                        Schedule Online Booking
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Highlights Counter Strip -->
<div class="bg-white py-4 border-bottom shadow-sm">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <div class="brand-font fs-2 text-primary fw-bold">12,500+</div>
                <div class="text-muted small text-uppercase">Vehicles Serviced</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="brand-font fs-2 text-primary fw-bold">25+</div>
                <div class="text-muted small text-uppercase">Master Technicians</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="brand-font fs-2 text-primary fw-bold">4.9 / 5</div>
                <div class="text-muted small text-uppercase">Customer Satisfaction</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="brand-font fs-2 text-primary fw-bold">60 Days</div>
                <div class="text-muted small text-uppercase">Service Warranty</div>
            </div>
        </div>
    </div>
</div>

<!-- Dynamic Services Catalog Section -->
<section class="py-5" id="services-catalog">
    <div class="container">
        <div class="text-center mb-5">
            <div class="text-uppercase fw-bold small text-muted letter-spacing mb-1" style="letter-spacing: 2px;">
                <span class="text-warning"><i class="fa-solid fa-screwdriver-wrench"></i></span> Professional Maintenance
            </div>
            <h2 class="display-6 brand-font fw-bold">Our Available Vehicle Services</h2>
            <p class="text-muted mx-auto" style="max-width: 600px;">
                Transparent pricing, zero hidden charges, and comprehensive multipoint inspections for two-wheelers and four-wheelers.
            </p>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var service in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="service-card">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="service-card-icon">
                                    <i class="@service.IconClass"></i>
                                </div>
                                <span class="badge bg-light text-dark border">
                                    <i class="fa-regular fa-clock me-1 text-muted"></i>@service.EstimatedDuration
                                </span>
                            </div>

                            <h3 class="service-card-title">@service.ServiceName</h3>
                            <p class="service-card-desc">@service.Description</p>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                                <div>
                                    <div class="service-card-price">₹@service.Price.ToString("N0")</div>
                                    <span class="service-card-duration">All inclusive charges</span>
                                </div>
                                <a asp-controller="Customer" asp-action="BookService" asp-route-serviceId="@service.ServiceId" class="btn btn-autocare-primary btn-sm px-3">
                                    <i class="fa-solid fa-calendar-plus me-1"></i>Book Now
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">No active services listed at the moment.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Why Choose AutoCare Section -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container">
        <div class="text-center mb-5">
            <div class="text-uppercase fw-bold small text-muted mb-1" style="letter-spacing: 2px;">The AutoCare Advantage</div>
            <h2 class="display-6 brand-font fw-bold">Why Discerning Drivers Choose Us</h2>
            <p class="text-muted mx-auto" style="max-width: 620px;">
                We combine traditional mechanical excellence with state-of-the-art digital computerized diagnostics to keep your machine in pristine shape.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="p-4 rounded-3 border bg-light h-100">
                    <div class="text-primary fs-3 mb-3"><i class="fa-solid fa-award"></i></div>
                    <h5 class="fw-bold mb-2">Certified Mechanics</h5>
                    <p class="text-muted small mb-0">
                        Our technicians undergo rigorous OEM certification programs with hands-on expertise across Japanese, German, and domestic vehicle architectures.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 rounded-3 border bg-light h-100">
                    <div class="text-primary fs-3 mb-3"><i class="fa-solid fa-receipt"></i></div>
                    <h5 class="fw-bold mb-2">Upfront Transparent Quotes</h5>
                    <p class="text-muted small mb-0">
                        No surprises at delivery. Every service request provides an itemized estimate, and additional repairs require explicit customer consent.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 rounded-3 border bg-light h-100">
                    <div class="text-primary fs-3 mb-3"><i class="fa-solid fa-shield-cat"></i></div>
                    <h5 class="fw-bold mb-2">60-Day Service Guarantee</h5>
                    <p class="text-muted small mb-0">
                        Drive with total confidence. All our periodic services and replacement parts carry an unconditional 60-day or 1,500 km warranty.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Banner -->
<section class="py-5 bg-primary text-white text-center" style="background-color: var(--primary-navy) !important;">
    <div class="container py-3">
        <h2 class="text-white display-6 brand-font mb-3">Ready to give your vehicle the care it deserves?</h2>
        <p class="text-white-50 mx-auto mb-4" style="max-width: 650px;">
            Book an appointment online in less than 2 minutes. Choose your preferred time slot and let our master technicians handle the rest.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Customer" asp-action="BookService" class="btn btn-autocare-gold btn-lg px-4">
                <i class="fa-solid fa-calendar-check me-2"></i>Schedule a Service Now
            </a>
            <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light btn-lg px-4">
                <i class="fa-solid fa-phone me-2"></i>Speak with Service Advisor
            </a>
        </div>
    </div>
</section>
